{
  "name": "@fortnox-mcp/s00-spike",
  "version": "0.0.0-experimental",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "tsx src/node.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:build": "node --disallow-code-generation-from-strings --test test/build.test.mjs",
    "build": "tsc --project tsconfig.build.json && esbuild src/worker.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/worker.js",
    "start": "node dist/node.js"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
