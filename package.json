{
  "name": "fortnox-mcp-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10.9.2 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/node/src/main.ts",
    "dev:docs": "node --env-file-if-exists=.env --import tsx apps/node/src/docs-main.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc --ip 127.0.0.1 --local",
    "dev:installation": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1 --local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "deploy": "npm run db:migrate && wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json && tsc --project tsconfig.tests.json",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:integration": "node scripts/acceptance.mjs fortnox",
    "test:clients": "node scripts/acceptance.mjs clients",
    "build": "node scripts/build.mjs",
    "test:build": "node --disallow-code-generation-from-strings --test tests/build.test.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "A database owned by your Cloudflare account. This test checks the schema only; Fortnox and remote MCP are disabled."
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
